CODEVAL_SECRET_KEY=change-me-in-production
CODEVAL_DATABASE_URL=postgresql+psycopg://codeval:codeval@localhost:5432/codeval
CODEVAL_TEST_DATABASE_URL=postgresql+psycopg://codeval:codeval@localhost:5432/codeval_test
CODEVAL_ACCESS_TOKEN_MINUTES=720
CODEVAL_CORS_ORIGINS=http://localhost:5173
CODEVAL_POOL_SIZE=10
CODEVAL_POOL_MAX_OVERFLOW=20
CODEVAL_SANDBOX_CPU_SECONDS=5
CODEVAL_SANDBOX_MEMORY_MB=256
CODEVAL_SANDBOX_WALL_TIMEOUT=10

# Envoi des e-mails par Mailjet (code de vérification à l'inscription, mot de
# passe oublié). L'adresse d'expédition doit être validée dans Mailjet.
# Laissées vides, le code de vérification s'affiche dans les journaux.
CODEVAL_MAILJET_API_KEY=
CODEVAL_MAILJET_API_SECRET=
CODEVAL_SMTP_FROM=noreply@votre-domaine.fr
CODEVAL_MAIL_FROM_NAME=CodEval
CODEVAL_FRONTEND_URL=http://localhost:5173

# Compte d'administration créé par `python -m app.seed`
CODEVAL_ADMIN_EMAIL=admin@example.com
CODEVAL_ADMIN_PASSWORD=change-me
CODEVAL_ADMIN_NAME=Administration
