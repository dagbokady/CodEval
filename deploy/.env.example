# Copier en deploy/.env sur le serveur, puis remplir. Ne jamais committer deploy/.env.

# Domaine sans https:// (le DNS doit pointer vers l'IP du VPS)
DOMAIN=codeval.exemple.com

# Générer avec : openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# Mailjet (adresse d'expédition validée dans le compte Mailjet)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=noreply@codeval.exemple.com

# Compte d'administration créé par : python -m app.seed
ORG_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
